# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are PUBLIC by design (data is protected by Row Level Security).
# Never put the service_role / secret key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Absolute URL of this site, used in email links (confirm / reset password).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" after enabling Google in Supabase → Authentication → Providers.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
